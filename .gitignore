# ビルド成果物
mac/dist/
# 署名・識別子の手元の値（雛形は config/Local.example.xcconfig）。
config/Local.xcconfig
# mac アプリの署名に使うプロビジョニングプロファイル（各自の手元のもの）。
mac/Resources/*.provisionprofile

# Swift Package Manager（どの階層でも）
.build/
.swiftpm/

# Claude Code の個人設定と作業用（agent の隔離 worktree）
.claude/settings.local.json
# 開発フロー（developer-plugin）の設定。GitHub の ID を含むので手元で持つ（雛形は github-project.example.json）。
.claude/github-project.json
.claude/worktrees/

# Xcode のユーザー別データ
xcuserdata/
DerivedData/

# OS / エディタ
.DS_Store
