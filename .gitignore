# 秘密情報はここに集約。README 以外は追跡しない。
secrets/*
!secrets/README.md

# 旧 statusLine が書いていた上限の残量（移行期間はアプリが読むので、手元に残っていても追跡しない）
data/claude-usage.json*

# ビルド成果物
node_modules/
mac/dist/
# 削除済みの monitor の残骸（手元に残る node_modules・UI のビルド成果物）を拾わないため。
/monitor/
*.tsbuildinfo

# Swift Package Manager（どの階層でも）
.build/
.swiftpm/

# Claude Code の個人設定と作業用（agent の隔離 worktree）
.claude/settings.local.json
.claude/worktrees/

# Xcode のユーザー別データ
xcuserdata/
DerivedData/

# OS / エディタ
.DS_Store
