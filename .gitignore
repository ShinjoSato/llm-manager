# 秘密情報はここに集約。README 以外は追跡しない。
secrets/*
!secrets/README.md

# 生成物（monitor/scripts/statusline.sh が書き出す上限の残量）
data/claude-usage.json*

# Node / ビルド成果物
node_modules/
mac/dist/
# 削除済みの UI の残骸（手元に残るビルド成果物）を拾わないため
monitor/ui/
*.tsbuildinfo

# Swift Package Manager（どの階層でも）
.build/
.swiftpm/

# Claude Code の個人設定と作業用（agent の隔離 worktree）
.claude/settings.local.json
.claude/worktrees/

# Xcode のユーザー別データ
xcuserdata/
DerivedData/

# OS / エディタ
.DS_Store
